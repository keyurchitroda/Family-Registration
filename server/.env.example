PORT=4000

# Path to Excel file (default: server/data/registrations.xlsx)
# EXCEL_PATH=C:\path\to\registrations.xlsx

SHEET_NAME=SPS_Registrations

# Vercel — set automatically when Vercel Blob is linked to the project
# BLOB_READ_WRITE_TOKEN=
# BLOB_EXCEL_PATHNAME=registrations.xlsx
# BLOB_ACCESS=private
# EXCEL_PATH=/tmp/registrations.xlsx

# Alternative on Vercel (free Upstash) if Blob is not used:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
