PORT=4000

# Recommended for live (2500+ families, multiple desks) — MongoDB Atlas
# Get the full string from Atlas → Database → Connect → Drivers → Node.js
# Password with @ must be URL-encoded as %40
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/family_registration?retryWrites=true&w=majority
# MONGODB_DB_NAME=family_registration

SHEET_NAME=SPS_Registrations

# Excel fallback when MONGODB_URI is not set (local laptop)
# EXCEL_PATH=C:\path\to\registrations.xlsx

# Vercel Blob (only if NOT using MongoDB)
# BLOB_READ_WRITE_TOKEN=
# BLOB_EXCEL_PATHNAME=registrations.xlsx
# EXCEL_PATH=/tmp/registrations.xlsx
